# ============================================================
# 环境变量模板 —— 复制为 .env 后按需修改
# ============================================================

# ---------- 服务配置 ----------
SERVER_HOST=127.0.0.1
SERVER_PORT=8023

# ---------- LLM 提供商（可选：ollama / dashscope / openai / deepseek） ----------
LLM_PROVIDER=ollama
LLM_MODEL_NAME=qwen3.5:4b

# 云端 API（使用云端模型时填写，本地模式可留空）
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# DASHSCOPE_MODEL=qwen-max
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# ---------- Ollama 本地模型 ----------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_FALLBACK_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=24h
OLLAMA_TIMEOUT_SECONDS=100
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=160
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.8
OLLAMA_TOP_K=20

# ---------- 本地模型 / 离线模式 ----------
LOCAL_MODEL_ONLY=true
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_LOCAL_FILES_ONLY=true
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ---------- 重排序模型 ----------
RERANKER_ENABLED=true
RERANKER_MODEL_PATH=
RERANKER_MAX_LENGTH=512

# ---------- 浏览器自动化 ----------
# 留空时自动探测系统 Chrome / Edge；非标准路径安装时才需要指定
BROWSER_CHANNEL=chrome
BROWSER_EXECUTABLE_PATH=
CLOAKBROWSER_BINARY_PATH=
# CLOAKBROWSER_CACHE_DIR=
# CLOAKBROWSER_DOWNLOAD_URL=
HEADLESS=false

# ---------- 授权管理（生产部署时务必修改为自有密钥） ----------
HUOKE_LICENSE_ADMIN_USER=admin
HUOKE_LICENSE_ADMIN_PASSWORD=change-me
HUOKE_LICENSE_SECRET=change-me-to-a-random-secret
HUOKE_LICENSE_SIGNATURE_ALG=ed25519
# HUOKE_LICENSE_PRIVATE_KEY=
# HUOKE_LICENSE_PUBLIC_KEY=
SECRET_KEY=change-me-to-a-random-secret
